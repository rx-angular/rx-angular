{
  "tasksRunnerOptions": {
    "default": {
      "options": {
        "canTrackAnalytics": false,
        "showUsageWarnings": true
      }
    }
  },
  "cli": {
    "analytics": false,
    "packageManager": "yarn"
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "cypress",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "jest"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "defaultProject": "demos",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "projectSpecificFiles"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "cypress": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "projectSpecificFiles": []
  },
  "release": {
    "projects": [
      "cdk",
      "template",
      "isr",
      "state",
      "eslint-plugin",
      "rebundle"
    ],
    "projectsRelationship": "independent",
    "conventionalCommits": {
      "types": {
        "docs": {
          "semverBump": "none",
          "changelog": {
            "title": "Documentation Changes"
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": false
        }
      }
    },
    "version": {
      "conventionalCommits": true
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}",
      "requireSemver": true,
      "strictPreid": true,
      "checkAllBranchesWhen": "main"
    },
    "git": {
      "commit": true,
      "tag": true
    },
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github"
      },
      "workspaceChangelog": false
    }
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"],
      "cache": true
    },
    "serve": {
      "inputs": ["production", "^production"]
    },
    "lint": [
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*",
          { "externalDependencies": ["eslint"] }
        ]
      }
    ],
    "e2e": [
      {
        "inputs": ["cypress", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/cypress/plugin"
        },
        "options": {
          "config-file": "./cypress.config.ts"
        }
      }
    ],
    "component-test": {
      "inputs": ["cypress", "^production"],
      "cache": true
    },
    "build-lib": {
      "cache": true
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "registry": "https://registry.npmjs.org/"
      }
    },
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ]
  },
  "parallel": 1,
  "nxCloudId": "68cae3e68a64e3329d3ced1e",
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/rebundle-demo/**/*",
        "apps/rebundle-demo-e2e/**/*",
        "apps/ssr/**/*",
        "apps/ssr-hydration/**/*",
        "apps/ssr-isr/**/*",
        "libs/cdk/**/*",
        "libs/eslint-plugin/**/*",
        "libs/isr/**/*",
        "libs/rebundle/**/*",
        "libs/state/**/*",
        "libs/template/**/*",
        "libs/test-helpers/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": [
        "apps/rebundle-demo-e2e/**/*",
        "apps/ssr/**/*",
        "apps/ssr-hydration/**/*",
        "apps/ssr-isr/**/*"
      ]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "component-test",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": ["libs/template/**/*"]
    }
  ]
}
