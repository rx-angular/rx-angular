{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "targets": {
    "build": {
      "executor": "@nx-plus/docusaurus:browser",
      "options": {
        "outputPath": "dist/apps/docs"
      },
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "executor": "@nx-plus/docusaurus:dev-server",
      "options": {
        "port": 3000
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docusaurus serve --config apps/docs/docusaurus.config.js --dir dist/apps/docs"
      },
      "dependsOn": [
        {
          "target": "build"
        }
      ]
    },
    "check-links": {
      "executor": "nx:run-commands",
      "options": {
        "command": "find ./apps/docs/general ./apps/docs/packages ./apps/docs/blog ./CONTRIBUTING.md \\( -name \"*.md\" -o -name \"*.mdx\" \\) -print0 | xargs -0 -n1 markdown-link-check -q -c markdown-link-check.config.json"
      }
    }
  },
  "tags": [],
  "namedInputs": {
    "projectSpecificFiles": ["{workspaceRoot}/CONTRIBUTING.md"]
  }
}
